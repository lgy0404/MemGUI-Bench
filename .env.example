# Agent model configuration
BASE_URL=https://openrouter.fans/v1
API_KEY=YOUR_API_KEY_HERE

# MemGUI-Eval configuration.
# The leaderboard uses google/gemini-2.5-flash for step descriptions and
# gemini-2.5-pro for final decisions to keep evaluation comparable.
MEMGUI_API_KEY=YOUR_API_KEY_HERE
MEMGUI_STEP_DESC_MODEL=google/gemini-2.5-flash
MEMGUI_STEP_DESC_PROVIDER=openai_compatible
MEMGUI_STEP_DESC_BASE_URL=
MEMGUI_FINAL_DECISION_MODEL=google/gemini-2.5-pro
MEMGUI_FINAL_DECISION_PROVIDER=openai_compatible
MEMGUI_FINAL_DECISION_BASE_URL=
MEMGUI_MAX_RETRIES=4

# Optional MobileWorld-compatible user/MCP settings.
DASHSCOPE_API_KEY=
MODELSCOPE_API_KEY=
USER_AGENT_API_KEY=
USER_AGENT_BASE_URL=
USER_AGENT_MODEL=gpt-4.1
